{
  "name": "dsh-amphoreus",
  "version": "0.1.0",
  "description": "翁法罗斯 × DSH：黄金裔席位工作区、技能无损桥接与画布工作台（基于 DeepSeek Harness 构建）",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.js.map",
    "lib/client.js",
    "lib/client.js.map",
    "lib/derive.js",
    "lib/derive.js.map",
    "lib/types/**/*.d.ts",
    "scripts/derive-assets.mjs",
    "cordis.patch.yml",
    "workbench/**",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "dev:link": "node scripts/dev-link.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "build:types": "node node_modules/typescript/bin/tsc -p tsconfig.json --emitDeclarationOnly",
    "build:js": "node node_modules/tsdown/dist/run.mjs",
    "build": "npm run typecheck && npm run build:types && npm run build:js",
    "derive": "node scripts/derive-assets.mjs",
    "watch": "node node_modules/tsdown/dist/run.mjs --watch",
    "test": "node --test tests/*.test.ts",
    "prepare": "npm run build:types && npm run build:js"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "license": "MIT",
  "keywords": ["dsh-plugin", "deepseek-harness", "amphoreus", "star-rail"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-skill": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-storage-domain": "0.1.2-alpha.4",
    "@deepseek-ai/schemastery": "^3.18.2",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-agent-loop": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-api-remotes": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-api-session-controller": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-api-workspace-controller": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-connection": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-locale": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-store": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-chat": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-session": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-settings-general": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-theme": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-workspace": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-web": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-host-webserver": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-workspace": "0.1.2-alpha.4",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "clsx": "^2.1.1",
    "lightningcss": "^1.32.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
